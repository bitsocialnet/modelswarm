{
  "name": "modelswarm",
  "version": "0.0.1",
  "private": true,
  "description": "An idea for a hub of open-weight AI models that nobody owns",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "packageManager": "yarn@4.17.1",
  "scripts": {
    "start": "node scripts/start-dev.ts",
    "build": "corepack yarn type-check && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "oxlint --deny-warnings src scripts vite.config.ts",
    "format": "oxfmt src scripts",
    "knip": "knip --production --include dependencies,unlisted,binaries --no-progress",
    "knip:full": "knip --no-progress --no-exit-code",
    "doctor": "react-doctor . -y",
    "deps:check-pinned": "node scripts/check-pinned-versions.ts",
    "agent:verify": "node scripts/agent-verify.ts",
    "ai-workflow:sync": "node scripts/sync-ai-workflow.ts",
    "ai-workflow:check": "node scripts/validate-ai-workflow.ts",
    "ai-workflow:test": "node --test --test-concurrency=1 scripts/__tests__/*.node-test.ts"
  },
  "dependencies": {
    "@adraffy/ens-normalize": "1.11.1",
    "@fontsource-variable/oxanium": "5.3.0",
    "@fontsource-variable/red-hat-mono": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "agentation": "3.1.2",
    "cross-spawn": "7.0.6",
    "element-source": "0.0.5",
    "js-yaml": "5.5.0",
    "knip": "6.42.1",
    "modern-web-guidance": "1.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "portless": "0.11.1",
    "react-doctor": "0.9.18",
    "smol-toml": "1.9.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
